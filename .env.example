# Application
PORT=3000
NODE_ENV=development

# Database (PostgreSQL via Docker)
DATABASE_URL=postgresql://sportgid:sportgid_pass@127.0.0.1:5433/sportgid

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_TTL=300

# Yandex Maps Geocoder
YANDEX_GEOCODER_API_KEY=your_api_key_here
YANDEX_GEOCODER_URL=https://geocode-maps.yandex.ru/1.x

# S3 Storage (TimeWEB)
S3_ENDPOINT=https://s3.timeweb.cloud
S3_BUCKET=sportgid
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ru-1